# Copia este archivo como .env (cp .env.example .env) y completa los valores. Nunca subas .env.

PORT=3000
ESTACION_ID=est01

# HiveMQ Cloud → tu cluster → "Connection details" (usa un usuario distinto al del ESP32)
MQTT_URL=mqtts://xxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USER=centinela-backend
MQTT_PASSWORD=

# Tokens de la app (inventa cadenas largas y aleatorias, ej: node -e "console.log(crypto.randomUUID())")
TOKEN_COMUNIDAD=
TOKEN_OPERADOR=

# Agente IA (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Push: instala la app "ntfy" en el teléfono y suscríbete a este topic (elige uno difícil de adivinar)
NTFY_TOPIC=centinela-cravosur-cambiame
# NTFY_SERVER=https://ntfy.sh

# Correo (opcional): Gmail con "contraseña de aplicación"
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Repetir la alerta roja cada N minutos hasta que alguien la reconozca
REPETIR_ROJO_MIN=2
NIVEL_DESBORDE_CM=14
